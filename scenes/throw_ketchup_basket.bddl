(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Throw the ketchup into the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (0.54 -0.01 0.56 0.01)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.17 -0.02 -0.13 0.02)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    ketchup_1 - ketchup
    basket_1 - basket
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On ketchup_1 floor_target_object_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)
