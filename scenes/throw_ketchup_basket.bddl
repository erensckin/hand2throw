(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Put the ketchup in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (0.54 -0.01 0.56 0.01)
            )
          )
      )
      (ketchup_region
          (:target floor)
          (:ranges (
              (-0.23 -0.01 -0.21 0.01)
            )
          )
      )
      (alphabet_soup_region
          (:target floor)
          (:ranges (
              (-0.23 -0.21 -0.21 -0.19)
            )
          )
      )
      (cream_cheese_region
          (:target floor)
          (:ranges (
              (-0.23 0.19 -0.21 0.21)
            )
          )
      )
      (milk_region
          (:target floor)
          (:ranges (
              (-0.11 -0.21 -0.09 -0.19)
            )
          )
      )
      (bbq_sauce_region
          (:target floor)
          (:ranges (
              (-0.11 0.19 -0.09 0.21)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    ketchup_1 - ketchup
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    milk_1 - milk
    bbq_sauce_1 - bbq_sauce
    basket_1 - basket
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On ketchup_1 floor_ketchup_region)
    (On alphabet_soup_1 floor_alphabet_soup_region)
    (On cream_cheese_1 floor_cream_cheese_region)
    (On milk_1 floor_milk_region)
    (On bbq_sauce_1 floor_bbq_sauce_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)
